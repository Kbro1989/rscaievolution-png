{
  "name": "copy-of-rsc-evolution-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cd rsc-cloudflare/rsc-client && npm install && mkdir -p dist && npm run build-dev && cp dist/index.bundle.js ../public/index.bundle.js && cd ../rsc-server && npm install && npm run build-browser && cp dist/browser.bundle.min.js ../public/server.bundle.min.js",
    "preview": "vite preview",
    "validate-setup": "tsx scripts/validate-setup.ts",
    "generate-models": "tsx scripts/generate-models.ts",
    "create-placeholders": "tsx scripts/create-placeholders.ts",
    "deploy": "cd rsc-cloudflare && npx wrangler deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "speaker": ">=0.5.4"
  },
  "dependencies": {
    "@2003scape/rsc-sounds": "^1.0.1",
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.2",
    "@types/crc": "^3.8.3",
    "@types/json-schema": "^7.0.15",
    "@types/node-fetch": "^2.6.11",
    "@types/sharp": "^0.31.1",
    "@types/sql.js": "^1.4.9",
    "@types/webpack-env": "^1.18.8",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autobind-decorator": "^2.4.0",
    "browserify-zlib": "^0.2.0",
    "classnames": "^2.5.1",
    "cmd-ts": "^0.14.3",
    "cobe": "^0.6.5",
    "comment-json": "^4.5.1",
    "crc": "^4.3.2",
    "geolib": "^3.3.4",
    "idb-keyval": "^6.2.2",
    "json-schema": "^0.4.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "lucide-react": "^0.554.0",
    "lzma": "^2.3.2",
    "lzma-native": "^8.0.6",
    "node-fetch": "^2.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.32.6",
    "sql.js": "^1.8.0",
    "sqlite3": "^6.0.1",
    "three": "^0.181.2"
  },
